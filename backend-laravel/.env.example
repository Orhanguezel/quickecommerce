APP_NAME=QuickEcommerce
APP_ENV=local
APP_KEY=base64:XDB2Mnph9AUrHgegbdyg1Mr3mIGv120vgs1pU0JtMBY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quick_ecommerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Production'da MAIL_MAILER=smtp olmalı; aksi halde tüm transactional
# mailler (sipariş onayı, şifre sıfırlama vs.) storage/logs/laravel.log'a
# yazılır ve gerçek mail gönderilmez.
#
# Yandex örneği:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.yandex.com
#   MAIL_PORT=465
#   MAIL_USERNAME=info@sportoonline.com
#   MAIL_PASSWORD="<uygulama-sifresi>"
#   MAIL_ENCRYPTION=ssl
# Gmail (App Password gerekli) örneği:
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="sportoonlinecom@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ALLOWED_ORIGINS=
DEMO_MODE=false

# Commerce readiness / controlled advertising
# Enable only after hero products have fresh market prices and
# commerce:refresh-readiness --apply has been run.
GOOGLE_FEED_ADS_ELIGIBLE_ONLY=false
AD_PILOT_EXCLUDED_SOURCES=dropick,speedwa,swan,powertec,raketspor,maraton
ABANDONED_CART_STAGE_3_MIN_TOTAL=2500
MARKET_PRICE_MAX_AGE_HOURS=48
MAX_AD_PRICE_INDEX=1.15

# Abandoned cart discounts are opt-in. Leave blank/zero unless the matching
# coupon really exists and is active in the admin panel.
ABANDONED_CART_STAGE_2_COUPON=
ABANDONED_CART_STAGE_2_DISCOUNT=0
ABANDONED_CART_STAGE_3_COUPON=
ABANDONED_CART_STAGE_3_DISCOUNT=0
ABANDONED_CART_MAX_REMINDERS_30D=3

# E-Arşiv (e-fatura-service mikroservis)
EINVOICE_ENABLED=false
EINVOICE_BASE_URL=http://127.0.0.1:8210
EINVOICE_API_KEY=
EINVOICE_WEBHOOK_SECRET=
EINVOICE_DEFAULT_TCKN=11111111111

# Currency Exchange Rate Settings
# API: https://api.exchangerate-api.com (Free - No key needed for basic use)
# For higher limits, get API key from: https://www.exchangerate-api.com/
# EXCHANGE_RATE_API_KEY=your_api_key_here

# Isolated scraper-service fallback for Cloudflare-heavy catalog sources.
FALLBACK_SCRAPER_URL=https://scraper.guezelwebdesign.com
FALLBACK_SCRAPER_API_KEY=
